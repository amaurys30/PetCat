# Variables para docker-compose.yml. Copiar a .env (en esta misma carpeta).
# Si cambias la contraseña después de crear el volumen mysql_data, MySQL la ignora:
# hay que borrar el volumen (docker compose down -v) para que se reinicialice.
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena
MYSQL_DATABASE=petcat_db

# Correo de cada backend en Docker: "mailpit" (por defecto) envía todo a Mailpit
# (http://127.0.0.1:8025, nada sale a internet); "smtp" usa el SMTP de backend/.env
# (SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS). Cada uno es independiente: se
# puede tener la API de demo en Mailpit y la de desarrollo con correo real. Al cambiarlos,
# recrear el contenedor: docker compose up -d --force-recreate backend
MAIL_MODO=mailpit
MAIL_MODO_DEMO=mailpit

# Opcional: modo desarrollo (código montado y recarga con nodemon) y API de demo del
# panel (perfil "panel") sin escribir -f ni --profile en cada comando. En Windows los
# archivos se separan con ";". Ver backend/README.md, "Dos backends en Docker".
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
# COMPOSE_PROFILES=panel
