# Copiar a backend/.env.test. Solo lo usa Vitest (ver vitest.config.js);
# backend/.env no se carga en los tests.
NODE_ENV=test

# Base exclusiva para tests: debe terminar en _test (lo exige src/config/env.js).
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=la_misma_de_MYSQL_ROOT_PASSWORD
DB_NAME=petcat_test

# Secretos solo para tests (no usar en desarrollo ni producción).
JWT_SECRET=test_jwt_secret_0123456789abcdefghijklmnop
REFRESH_SECRET=test_refresh_secret_0123456789abcdefghijk
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=7d

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAIL_FROM="PetCat <no-reply@petcat.co>"
