# Copiar a backend/.env. Las variables se validan en src/config/env.js:
# si falta una obligatoria, el servidor no arranca.

# --- Servidor ---
# development | test | production
NODE_ENV=development
PORT=3000

# --- Base de datos (obligatorias: DB_USER, DB_PASSWORD, DB_NAME) ---
# Con docker compose, MySQL queda en localhost:3307. Dentro de Docker,
# docker-compose.yml sobrescribe DB_HOST, DB_PORT y DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=la_misma_de_MYSQL_ROOT_PASSWORD
DB_NAME=petcat_db

# --- JWT (obligatorias; mínimo 32 caracteres y distintas entre sí) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_SECRET=
REFRESH_EXPIRES_IN=30d

# --- Códigos de 6 dígitos de los correos (verificación y recuperación) ---
# Clave del HMAC con que se guardan. Obligatoria en producción, mínimo 32 caracteres y
# distinta de JWT_SECRET y REFRESH_SECRET (mismo comando para generarla). En desarrollo,
# si falta, se deriva de JWT_SECRET. Cambiarla invalida los códigos ya enviados.
CODIGO_SECRET=

# --- URLs ---
# URL pública de esta API
APP_URL=http://localhost:3000
# Panel web; se usa en los enlaces de los correos
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# --- Correo --- (detalle en backend/README.md, "Correo")
# En Docker, MAIL_MODO / MAIL_MODO_DEMO del .env de la raíz deciden: "mailpit" (por defecto)
# ignora estas variables y envía a Mailpit; "smtp" usa las de aquí.
# Fuera de Docker (npm run dev): sin SMTP_HOST los correos se muestran en consola; para
# Mailpit usa SMTP_HOST=localhost, SMTP_PORT=1025 y SMTP_SECURE=none.
# En producción SMTP_HOST es obligatorio.
#
# Gmail (con contraseña de aplicación):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=starttls
#   SMTP_USER=tu_cuenta@gmail.com  SMTP_PASS=<contraseña de aplicación de 16 letras>
SMTP_HOST=
SMTP_PORT=587
# Cifrado: tls (TLS directo, puerto 465), starttls (exige STARTTLS, puerto 587) o none
# (sin cifrar: solo Mailpit u otro servidor local). Vacío: 465 -> tls; con usuario ->
# starttls; sin usuario -> none.
SMTP_SECURE=
# Usuario y contraseña van juntos; vacíos = SMTP sin autenticación. Nunca los subas al repositorio.
SMTP_USER=
SMTP_PASS=
# Con un proveedor real, el remitente debe ser una dirección o dominio verificado en él
# (en Gmail, la misma cuenta de SMTP_USER).
MAIL_FROM="PetCat <no-reply@petcat.co>"
# Tiempo máximo en ms para conectar y para cada operación del SMTP (por defecto 10000).
# Si se supera, el envío falla con 503 en lugar de quedarse esperando.
SMTP_TIMEOUT_MS=10000

# --- Límite de solicitudes ---
# Máximo cada 15 min por IP en toda la API. Si se deja vacío: 300.
RATE_LIMIT_MAX=
# Máximo cada 15 min por IP en login, forgot-password, reset-password, verify-email,
# resend-verification e invitaciones.
# Si se deja vacío: 10 en producción, 100 en desarrollo.
AUTH_RATE_LIMIT_MAX=

# --- Archivos (Cloudinary) ---
# Panel de Cloudinary: el cloud name está en el Dashboard; la API key y el secret, en
# Settings > API Keys. Las tres van juntas. Obligatorias en producción; en desarrollo,
# sin ellas la API funciona pero las subidas responden 503. El secret firma las URLs
# de los archivos privados: no compartirlo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz en Cloudinary, una por entorno (p. ej. petcat-dev, petcat-prod).
CLOUDINARY_FOLDER=petcat-dev
# Minutos de vigencia de las URLs firmadas del historial y los comprobantes (por defecto 15).
ARCHIVOS_URL_VIGENCIA_MIN=15

# --- Notificaciones push (Expo) ---
# Opcional: solo si el proyecto de Expo tiene activada "Enhanced security for push notifications"
# (expo.dev > proyecto > Credentials > Access tokens). Sin ella, las push se envían igual.
EXPO_ACCESS_TOKEN=
