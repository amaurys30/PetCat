# Copiar a backend/.env. Las variables se validan en src/config/env.js:
# si falta una obligatoria, el servidor no arranca.

# --- Servidor ---
# development | test | production
NODE_ENV=development
PORT=3000

# --- Base de datos (obligatorias: DB_USER, DB_PASSWORD, DB_NAME) ---
# Con docker compose, MySQL queda en localhost:3307. Dentro de Docker,
# docker-compose.yml sobrescribe DB_HOST, DB_PORT y DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=la_misma_de_MYSQL_ROOT_PASSWORD
DB_NAME=petcat_db

# --- JWT (obligatorias; mínimo 32 caracteres y distintas entre sí) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_SECRET=
REFRESH_EXPIRES_IN=30d

# --- URLs ---
# URL pública de esta API
APP_URL=http://localhost:3000
# Panel web; se usa en los enlaces de los correos
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# --- Correo ---
# Obligatorio en producción. En desarrollo, sin SMTP_HOST los correos se muestran
# en consola; para probar envíos reales se puede usar una cuenta de ethereal.email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PetCat <no-reply@petcat.co>"
# Tiempo máximo en ms para conectar y para cada operación del SMTP (por defecto 10000).
# Si se supera, el envío falla con 503 en lugar de quedarse esperando.
SMTP_TIMEOUT_MS=10000

# --- Límite de solicitudes ---
# Máximo cada 15 min por IP en login, forgot-password, reset-password, verify-email,
# resend-verification e invitaciones.
# Si se deja vacío: 10 en producción, 100 en desarrollo.
AUTH_RATE_LIMIT_MAX=
