# Copiar a .env.local (no se sube). Expo solo pasa a la app las variables EXPO_PUBLIC_*,
# y quedan dentro del bundle: nunca poner secretos aquí.

# URL de la API. Vacía: en desarrollo se usa la IP del computador que sirve el bundle
# (la misma que muestra Expo) con el puerto 3001 (API de demo, petcat_demo).
# Con adb reverse (USB): http://localhost:3001/api/v1
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3001/api/v1
