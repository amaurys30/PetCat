# Copiar a .env (no se sube). Solo las variables EXPO_PUBLIC_* llegan a la app y quedan dentro
# del bundle: nunca secretos aquí. Se validan con Zod en src/lib/env.ts.

# URL de la API de demo (backend-demo, puerto 3001), con la IP del computador en la wifi.
# Si se deja vacía, en desarrollo se usa la IP con la que Expo sirve el bundle + 3001.
# Por USB con adb reverse: http://localhost:3001/api/v1
EXPO_PUBLIC_API_URL=

# Socket.IO (M5). Vacía: el mismo origen de la API.
EXPO_PUBLIC_SOCKET_URL=
