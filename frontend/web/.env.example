# Copiar a frontend/web/.env.local (no se sube al repositorio).

# Base de la API. En desarrollo pasa por el proxy de Vite, así que no hay CORS.
VITE_API_URL=/api/v1
# Servidor de Socket.IO (mismo puerto de la API, sin /api/v1).
VITE_SOCKET_URL=http://localhost:3000
# Opcional: a dónde reenvía el proxy de Vite (por defecto http://localhost:3000).
# Útil si la API de demo corre en otro puerto: VITE_API_PROXY=http://localhost:3001
VITE_API_PROXY=
# Opcional (P1): Google Maps y Places. Restringida en Google Cloud a los dominios del panel
# (y localhost) y solo a Maps JavaScript API y Places API. Sin clave, las sedes usan
# latitud y longitud manuales.
VITE_GOOGLE_MAPS_API_KEY=
