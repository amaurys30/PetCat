# Copiar a frontend/web/.env.local (no se sube al repositorio). Todas son opcionales.

# Base de la API en el build (producción). En desarrollo (npm run dev y dev:red) no se usa: el
# panel llama a /api/v1 y el proxy de Vite la reenvía, así que no hay CORS. Por defecto /api/v1.
VITE_API_URL=/api/v1
# A dónde reenvía el proxy de Vite /api y /socket.io (dev, dev:red y vite preview). Por defecto,
# la API de demo en Docker (servicio backend-demo, base petcat_demo, en 127.0.0.1:3001).
VITE_API_PROXY_TARGET=http://localhost:3001
# Servidor de Socket.IO (agenda en tiempo real) en el build. Vacío: el mismo origen del panel.
# En desarrollo no se usa: siempre el mismo origen, a través del proxy.
VITE_SOCKET_URL=
# Opcional: mosaicos del mapa de las sedes (Leaflet). Vacío: OpenStreetMap, sin clave, solo para
# desarrollo y poco tráfico (https://operations.osmfoundation.org/policies/tiles/). Para producción,
# la plantilla del proveedor elegido con {z}, {x}, {y} (y {s} si usa subdominios), con su clave si
# la pide (restringida al dominio del panel), y la atribución que exija (HTML).
VITE_MAP_TILES_URL=
VITE_MAP_ATTRIBUTION=
