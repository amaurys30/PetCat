# Copiar a frontend/web/.env.local (no se sube al repositorio). Todas son opcionales.

# Base de la API. En desarrollo pasa por el proxy de Vite, así que no hay CORS.
VITE_API_URL=/api/v1
# A dónde reenvía el proxy de Vite /api y /socket.io. Por defecto, la API de demo en Docker
# (servicio backend-demo, base petcat_demo, en 127.0.0.1:3001).
VITE_API_PROXY_TARGET=http://localhost:3001
# Servidor de Socket.IO (P6). Vacío: el mismo origen del panel, a través del proxy.
VITE_SOCKET_URL=
# Opcional (P1): Google Maps y Places. Restringida en Google Cloud a los dominios del panel
# (y localhost) y solo a Maps JavaScript API y Places API. Sin clave, las sedes usan
# latitud y longitud manuales.
VITE_GOOGLE_MAPS_API_KEY=
