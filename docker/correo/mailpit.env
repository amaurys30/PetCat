# Modo de correo "mailpit" (MAIL_MODO / MAIL_MODO_DEMO en el .env de la raíz).
# Docker Compose carga este archivo después de backend/.env, así que estos valores
# reemplazan los de SMTP de backend/.env solo en el contenedor que usa este modo.
# Todos los correos llegan a Mailpit: http://127.0.0.1:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
# Vacíos a propósito: Mailpit no pide usuario. Una variable vacía cuenta como ausente,
# así que no se usan las credenciales reales que haya en backend/.env.
SMTP_USER=
SMTP_PASS=
